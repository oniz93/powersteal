[gd_scene format=3 uid="uid://hubmenu001"]

[ext_resource type="Script" path="res://scenes/ui/hub_menu.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.12, 0.12, 0.15, 1)

[node name="HubMenu" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Panel" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")

[node name="Title" type="Label" parent="Panel"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 10.0
offset_bottom = 33.0
grow_horizontal = 2
theme_override_font_sizes/font_size = 16
text = "POWERSTEAL - MISSION SELECT"
horizontal_alignment = 1

[node name="HBox" type="HBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 40.0
offset_right = -20.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="VBox_Missions" type="VBoxContainer" parent="Panel/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Label" type="Label" parent="Panel/HBox/VBox_Missions"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 10
text = "AVAILABLE TARGETS:"

[node name="MissionList" type="VBoxContainer" parent="Panel/HBox/VBox_Missions"]
layout_mode = 2
size_flags_vertical = 3

[node name="SettingsButton" type="Button" parent="Panel/HBox/VBox_Missions"]
layout_mode = 2
text = "Settings"

[node name="VBox_Dossier" type="VBoxContainer" parent="Panel/HBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.0

[node name="Label" type="Label" parent="Panel/HBox/VBox_Dossier"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 10
text = "DOSSIER:"

[node name="DebugUnlockButton" type="Button" parent="Panel/HBox/VBox_Dossier"]
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "[DEBUG] Unlock All"

[node name="Panel" type="Panel" parent="Panel/HBox/VBox_Dossier"]
layout_mode = 2
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="Panel/HBox/VBox_Dossier/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/normal_font_size = 10
theme_override_font_sizes/bold_font_size = 10
bbcode_enabled = true

[node name="StartButton" type="Button" parent="Panel/HBox/VBox_Dossier"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "START MISSION"

[connection signal="pressed" from="Panel/HBox/VBox_Missions/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Panel/HBox/VBox_Dossier/StartButton" to="." method="_on_start_pressed"]
